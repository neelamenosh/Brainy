# Copy to .env.local for local dev
# Create a managed Postgres database (Neon/Supabase/Vercel Postgres) and paste the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# Supabase (optional)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Server-side only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Auth signing secrets (set strong random values)
JWT_SECRET="replace-with-long-random-string"
REFRESH_TOKEN_SECRET="replace-with-long-random-string"

# Frontend can override auth base URL for local backend (optional)
# VITE_API_BASE_URL="http://localhost:3001/api/auth"
