generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  rollNumber   String      @unique
  fullName     String
  email        String      @unique
  phone        String
  passwordHash String
  department   String
  course       String?
  semester     Int?
  role         String?       @default("Student")
  createdAt    DateTime?     @default(now()) @db.Timestamptz(6)
  lastLogin    DateTime?     @db.Timestamptz(6)

  quizAttempts QuizAttempt[]
}

model QuizCategory {
  id          String        @id
  name        String
  description String?
  courseId    String?
  courseName  String?

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  categoryId   String
  questionText String
  options      Json
  correctIndex Int
  order        Int

  category     QuizCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([categoryId, order])
}

model QuizAttempt {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String
  categoryId  String
  score       Int
  total       Int
  percentage  Int
  createdAt   DateTime?   @default(now()) @db.Timestamptz(6)

  category    QuizCategory @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([categoryId, createdAt], map: "idx_quiz_attempt_category_created")
  @@index([userId, createdAt], map: "idx_quiz_attempt_user_created")
}
